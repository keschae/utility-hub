# ---------------------------------------------------------------------------
# Utility Hub API configuration
# Copy to .env and edit. .env is gitignored.
# ---------------------------------------------------------------------------

# 'dev'   = trust unsigned fake tokens, no tenant required (LOCAL ONLY)
# 'entra' = validate real Entra ID access tokens
AUTH_MODE=dev

PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Required when AUTH_MODE=entra ----------------------------------------

# Directory (tenant) ID — Entra portal > Overview
ENTRA_TENANT_ID=

# Application (client) ID of the *API* app registration.
# This is the audience this API will accept tokens for.
ENTRA_API_CLIENT_ID=

# The delegated scope name you exposed on the API app registration,
# under "Expose an API". Just the name, not the full URI.
ENTRA_REQUIRED_SCOPE=access_as_user
