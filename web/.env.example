# ---------------------------------------------------------------------------
# Utility Hub web configuration
# Copy to .env.local and edit. Vite only exposes VITE_-prefixed vars.
# ---------------------------------------------------------------------------

# Where the API lives. Leave blank to use the Vite dev proxy (recommended
# locally, avoids CORS entirely). Set to a full origin in deployed builds,
# e.g. https://utility-hub-api.example.com
VITE_API_BASE_URL=

# ---- Required only when running against a real tenant ---------------------
# When these are blank the app runs in dev mode and shows the fake-login
# role picker. The API must also be set to AUTH_MODE=dev to match.

# Application (client) ID of the *SPA* app registration (not the API's).
VITE_ENTRA_CLIENT_ID=

# Directory (tenant) ID.
VITE_ENTRA_TENANT_ID=

# The full scope URI exposed by the API app registration, e.g.
# api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_ENTRA_API_SCOPE=
